#!/bin/sh
# Crontinental notify hook: a push to your phone through ntfy (https://ntfy.sh).
#
#   cp notify/examples/ntfy ~/.config/crontinental/notify.d/ntfy
#
# then set TOPIC below (anyone who knows a topic on ntfy.sh can read it, so
# make it unguessable), or point SERVER at your own ntfy. A job booked with
# --tag ntfy_topic=<topic> goes to that topic instead.

SERVER=https://ntfy.sh
TOPIC=${CRONTINENTAL_TAG_NTFY_TOPIC:-change-me}

priority=default
[ "$CRONTINENTAL_URGENCY" = critical ] && priority=high

exec curl -fsS -o /dev/null \
  -H "Title: $CRONTINENTAL_HEADLINE" \
  -H "Priority: $priority" \
  -H "Tags: $CRONTINENTAL_EVENT,$CRONTINENTAL_HOST" \
  -d "$CRONTINENTAL_BODY" \
  "$SERVER/$TOPIC"
